OPENROUTER_API_KEY=sk-or-v1-...

# Klasyfikator: llm (mały model w OpenRouter) albo jev (TypeSafe, wymaga TYPESAFE_API_KEY)
CLASSIFIER=llm
TYPESAFE_API_KEY=apikey_...

